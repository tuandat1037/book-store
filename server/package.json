{
  "name": "book-store-server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run src/__tests__/promotion.unit.test.ts src/__tests__/constants.unit.test.ts",
    "test:api": "vitest run src/__tests__/auth.api.test.ts src/__tests__/books.api.test.ts src/__tests__/orders.api.test.ts src/__tests__/categories.api.test.ts",
    "test:api:testdb": "cross-env DB_NAME=kimdong_bookstore_test vitest run src/__tests__/auth.api.test.ts src/__tests__/books.api.test.ts src/__tests__/orders.api.test.ts src/__tests__/categories.api.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.9.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "supertest": "^7.2.2",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vite": "^5.0.12",
    "vitest": "^1.6.1"
  }
}
